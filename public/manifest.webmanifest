{
  "name": "ฟิล์มบล็อคสกรีน",
  "short_name": "ฟิล์มบล็อค",
  "description": "เตรียมฟิล์ม positive สำหรับถ่ายบล็อคสกรีนจากไฟล์ลูกค้า (.ai / .pdf / .zip)",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "th",
  "background_color": "#eef0f3",
  "theme_color": "#4a3fb0",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [".ai", ".pdf", ".zip", "application/pdf", "application/postscript", "application/illustrator", "application/vnd.adobe.illustrator", "application/zip", "application/x-zip-compressed", "application/octet-stream"]
        }
      ]
    }
  }
}
